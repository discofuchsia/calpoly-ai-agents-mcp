{
  "name": "calpoly-ai-agents-mcp",
  "version": "1.0.0",
  "description": "Talk deck and live demo: A Day in the Life of an AI Engineer: AI Agents and MCP",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "mcp": "node server/mcp-server.mjs",
    "tools:list": "node scripts/list-tools.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node server/mcp-server.mjs",
    "start": "npm run build && node --env-file-if-exists=.env backend/server.mjs",
    "demo:mock": "npm run build && LLM_PROVIDER=mock MOCK_LATENCY_MS=900 node backend/server.mjs",
    "record": "node --env-file-if-exists=.env scripts/record-replay.mjs",
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "e2e": "node test/e2e/dist.e2e.mjs",
    "verify": "npm test && npm run build && npm run audit && npm run e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-bedrock-runtime": "^3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5",
    "@fontsource/jetbrains-mono": "^5",
    "puppeteer-core": "^24",
    "qrcode": "^1.5.4"
  }
}
