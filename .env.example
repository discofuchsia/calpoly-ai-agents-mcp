# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# LLM provider: mock (default, no key needed) | anthropic | bedrock
# LLM_PROVIDER=mock

# Anthropic API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Amazon Bedrock (uses the default AWS credential chain)
# AWS_PROFILE=
# AWS_REGION=us-west-2
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Demo backend port (always binds 127.0.0.1)
# PORT=8787

# Simulated latency per mock LLM turn, in milliseconds
# MOCK_LATENCY_MS=0
